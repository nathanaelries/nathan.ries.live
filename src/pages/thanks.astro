---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout
  title="Thanks | Nathanael Ries"
  description="Your message was received."
>
  <section class="py-24 bg-white">
    <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl font-extrabold text-gray-900 mb-4">Thanks for reaching out.</h1>
      <p class="text-lg text-gray-700 mb-8">
        Your message landed. I'll get back to you as soon as I can.
      </p>
      <a
        href="/"
        class="inline-flex items-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 transition-colors duration-300"
      >
        Back to home
      </a>
    </div>
  </section>
</MainLayout>
