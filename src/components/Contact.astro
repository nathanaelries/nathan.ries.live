---
import SectionTitle from './SectionTitle.astro';
import ContactForm from './ContactForm.astro';
---

<section id="contact" class="py-12 sm:py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle>Contact</SectionTitle>
    <div class="mt-10 grid grid-cols-1 lg:grid-cols-2 gap-10 max-w-5xl mx-auto">
      <div class="space-y-6">
        <p class="text-gray-700">
          Best way to reach me is email. I'm open to remote DevOps, Platform,
          and Infrastructure Engineer roles, especially at eDiscovery and
          legaltech companies.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <p class="text-xs uppercase tracking-widest text-gray-500 mb-1">Email</p>
            <a
              href="mailto:nathanael.ries@gmail.com"
              class="text-base font-medium text-indigo-700 hover:text-indigo-900 underline-offset-2 hover:underline"
            >
              nathanael.ries@gmail.com
            </a>
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-gray-500 mb-1">Location</p>
            <span class="text-base font-medium text-gray-900">Tullahoma, TN &middot; Open to Remote</span>
          </div>
          <div>
            <p class="text-xs uppercase tracking-widest text-gray-500 mb-1">GitHub</p>
            <a
              href="https://github.com/nathanaelries"
              target="_blank"
              rel="noopener noreferrer"
              class="text-base font-medium text-indigo-700 hover:text-indigo-900 underline-offset-2 hover:underline"
            >
              github.com/nathanaelries
            </a>
          </div>
        </div>
        <div class="pt-2">
          <a
            href="/Nathanael_Ries_Resume.pdf"
            download
            class="inline-flex items-center px-5 py-3 border border-transparent text-base font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 transition-colors duration-300"
          >
            Download résumé (PDF)
          </a>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h3 class="text-lg font-bold text-gray-900 mb-4">Send a message</h3>
        <ContactForm />
      </div>
    </div>
  </div>
</section>
