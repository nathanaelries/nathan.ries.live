---
import SectionTitle from './SectionTitle.astro';
import { experiences } from '../data/experiences.js';
---

<section id="experience" class="py-12 sm:py-16 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle>Experience</SectionTitle>
    <div class="mt-10 max-w-4xl mx-auto">
      {experiences.map((exp) => (
        <div class="mb-10 border-l-4 border-indigo-600 pl-4 hover:border-indigo-700 transition-colors duration-300">
          <div class="flex flex-wrap items-baseline justify-between gap-x-3">
            <h3 class="text-xl font-bold text-gray-900">{exp.title}</h3>
            <p class="text-sm font-medium text-gray-500">{exp.period}</p>
          </div>
          <p class="text-gray-700 font-medium">
            {exp.company}
            {exp.location && <span class="text-gray-500 font-normal"> &middot; {exp.location}</span>}
          </p>
          {exp.summary && <p class="mt-2 text-gray-700">{exp.summary}</p>}
          {exp.highlights && exp.highlights.length > 0 && (
            <ul class="mt-3 space-y-2 text-gray-700 list-disc pl-5 marker:text-indigo-500">
              {exp.highlights.map((h) => <li>{h}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
