---
import SectionTitle from './SectionTitle.astro';
import { skillCategories } from '../data/skills.js';
---

<section id="skills" class="py-12 sm:py-16 bg-gray-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionTitle>Skills</SectionTitle>
    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
      {skillCategories.map((cat) => (
        <div class="bg-white rounded-lg shadow p-6 hover:shadow-md transition-shadow duration-300">
          <h3 class="text-lg font-bold text-gray-900 mb-4">{cat.title}</h3>
          <ul class="flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <li class="text-sm bg-indigo-50 text-indigo-900 px-3 py-1 rounded-full border border-indigo-100">
                {skill}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
